# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
# 값은 Supabase 대시보드의 프로젝트 설정(API Keys)에서 확인한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI Insight 에 쓰는 값. 비워 두면 AI Insight 만 만들 수 없고 나머지 기능은 그대로 동작한다.
# 키는 console.anthropic.com 에서 만든다. 서버에서만 읽으므로 이름에 NEXT_PUBLIC_ 을 붙이지 않는다.
ANTHROPIC_API_KEY=
# 쓸 모델. 비우면 claude-opus-5-5 를 쓴다. 비용을 줄이려면 claude-sonnet-5-5 나 claude-haiku-5-5 로 바꾼다.
AI_INSIGHT_MODEL=
# mock 으로 두면 키 없이 예시 내용을 만든다. 개발할 때만 쓰고 배포한 환경에서는 무시된다.
AI_INSIGHT_PROVIDER=
