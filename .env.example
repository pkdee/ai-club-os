# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
# 값은 Supabase 대시보드의 프로젝트 설정(API Keys)에서 확인한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI Insight 에 쓰는 값. 비워 두면 AI Insight 만 만들 수 없고 나머지 기능은 그대로 동작한다.
# 키는 console.anthropic.com 에서 만든다. 서버에서만 읽는다. 이름에 NEXT_PUBLIC_ 을 붙이면 브라우저로 나가므로 절대 붙이지 않는다.
# 키를 넣은 .env.local 은 저장소에 올리지 않는다(.gitignore 가 막고 있다). 배포할 때는 배포 서비스의 환경 변수에 넣는다.
ANTHROPIC_API_KEY=
# 쓸 모델. 비우면 claude-sonnet-5-5 를 쓴다. 더 싸게는 claude-haiku-5-5, 더 좋은 품질로는 claude-opus-5-5 로 바꾼다.
AI_INSIGHT_MODEL=
# mock 으로 두면 키 없이 예시 내용을 만든다. 개발할 때만 쓰고 배포한 환경에서는 무시된다.
AI_INSIGHT_PROVIDER=

# 개인 정보 안내 화면에 보여 줄 문의 주소. 비워 두면 Club 의 운영자에게 물으라고 안내한다.
# 그 화면은 빌드할 때 만들어지므로 값을 바꾸면 다시 빌드해야 반영된다.
CONTACT_EMAIL=
